<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (seat alerts). Xcode switches this to "production" when it signs an
	     App Store / TestFlight build; "development" is right for builds run straight from Xcode. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
